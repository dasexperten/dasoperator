# HTML pages: never cache. Always fetch fresh from origin so the
# JS chunk hashes embedded in HTML match what's actually on the CDN.
# Without this, browsers hold onto a stale HTML referencing chunks
# that have been replaced on a new deploy → ChunkLoadError, blank page.
/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Static assets with content-hashed filenames are safe to cache forever.
# Next.js puts these under /_next/static/.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Static media (images, fonts under /brand and /fonts) — long cache.
/brand/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
