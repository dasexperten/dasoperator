# SPA-style fallback for dynamic routes — any newly-created entity
# (product, partner, warehouse, contract, operation, payment) is reachable
# immediately without a Pages rebuild.
#
# Cloudflare Pages reads this file. Each rule routes any path matching
# the source to the __fallback statically-generated page; the client
# component reads window.location.pathname to know the real id.

/products/*                          /products/__fallback/  200
/warehouses/*                        /warehouses/__fallback/  200
/partners/*/operations/new           /partners/__fallback/operations/new/  200
/partners/*/payments/new             /partners/__fallback/payments/new/  200
/partners/*/contracts/new            /partners/__fallback/contracts/new/  200
/partners/*/operations/*             /partners/__fallback/operations/__fallback/  200
/partners/*/contracts/*              /partners/__fallback/contracts/__fallback/  200
/partners/*                          /partners/__fallback/  200
